### VS Code ###
.vscode/

# Security: ignore sensitive files and credentials to avoid leaking secrets
# Environment files
.env
.env.*
*.env

# Application config (Spring Boot)
application.properties
application-*.properties
application.yml
application-*.yml

# Secrets and credentials
secrets.yml
secrets.json
credentials
/.aws/credentials

# Keystores, certificates and keys
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
*.crt
*.cer
*.p7b
keystore.*

# Build system and gradle properties that may contain secrets
.gradle/
gradle.properties
**/gradle.properties

# Logs and runtime files
*.log
/logs/

# OS and editor files
.DS_Store
Thumbs.db
.history

# Misc
node_modules/
.idea/
.vscode/

# If any local files contain credentials, add them here explicitly
# e.g., /path/to/local/credentials.file


